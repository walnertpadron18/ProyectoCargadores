            <column caption='% BEV' datatype='real' default-format='p0%' name='[Calculation_0972308613849097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bev]) / (SUM([bev]) + SUM([phev]))' />
            </column>
            <column caption='% PHEV' datatype='real' default-format='p0%' name='[Calculation_0972308615090186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - [Calculation_0972308613849097]' />
            </column>
            <column datatype='real' name='[bev]' role='measure' type='quantitative' />
            <column datatype='date' name='[fecha]' role='dimension' type='ordinal' />
            <column-instance column='[fecha]' derivation='None' name='[none:fecha:qk]' pivot='key' type='quantitative' />
            <column-instance column='[pais (evolucion_mensual.csv)]' derivation='None' name='[none:pais (evolucion_mensual.csv):nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[pais (evolucion_mensual.csv)]' role='dimension' type='nominal' />
            <column datatype='real' name='[phev]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0972308613849097]' derivation='User' name='[usr:Calculation_0972308613849097:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0972308615090186]' derivation='User' name='[usr:Calculation_0972308615090186:qk]' pivot='key' type='quantitative' />
