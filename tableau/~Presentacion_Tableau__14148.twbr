      <column caption='Cálculo2' datatype='string' name='[Calculation_0972308429594625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [pct_carga_rapida] &lt; 28 AND [bev_por_punto_rapido] &gt; 40&#13;&#10;THEN &quot;Oportunidad&quot; ELSE &quot;Resto&quot; END' />
      </column>
      <column caption='Grupo' datatype='string' name='[Calculation_0972308594954242]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [ratio_elec_gasolina] &lt; 1 THEN &quot;La gasolina aún domina&quot;&#13;&#10;   ELSE &quot;El eléctrico ya supera a la gasolina&quot; END' />
      </column>
