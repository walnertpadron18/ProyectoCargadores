      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#240190' fontname='Arial'>PHEV VS BEV de matriculación en los últimos 12 meses</run>
            <run fontalignment='1'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
