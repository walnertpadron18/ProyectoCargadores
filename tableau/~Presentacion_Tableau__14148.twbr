          <formatted-text>
            <run fontalignment='1' fontcolor='#240190' fontname='Arial' fontsize='14'>1. Los 5 países prioritarios son </run>
            <run bold='true' fontalignment='1' fontcolor='#240190' fontname='Arial' fontsize='14'>Irlanda, Países Bajos, Luxemburgo, Alemania y Eslovenia.</run>
            <run fontalignment='1' fontcolor='#240190' fontname='Arial' fontsize='14'>Æ </run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#444444' />
